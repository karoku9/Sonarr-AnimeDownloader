{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "docker-run: debug",
			"type": "docker-run",
			"dependsOn": ["docker-build"],
			"dockerRun": {
				"containerName": "AnimeDownloader",
				"os": "Linux",
				"image": "mainkronos/anime_downloader:latest",
				"env": {
					"SONARR_URL": "${env:ANIDOWN_LEGACY_SONARR_URL}",
					"API_KEY": "${env:ANIDOWN_LEGACY_SONARR_API_KEY}",
					"TZ": "Europe/Rome",
					"PUID": "1000",
					"PGID": "1000"
				},
				"ports": [{"containerPort": 5000, "hostPort": 8573}],
				"volumes": [
					{"containerPath": "/script/json/", "localPath": "${workspaceFolder}/documentation/examples/json"},
					{"containerPath": "/script/connections/", "localPath": "${workspaceFolder}/documentation/examples/connections"}
				]
			},
			"python": {"file": "main.py"}
		},
		{
			"label": "docker-build",
			"type": "docker-build",
			"dockerBuild": {
				"context": "${workspaceFolder}",
				"dockerfile": "${workspaceFolder}/Dockerfile",
				"tag": "mainkronos/anime_downloader:latest"
			}
		},
		{
			"label": "Type Check",
			"type": "shell",
			"command": "python -m mypy",
			"args": ["${workspaceFolder}/src", "--show-column-numbers", "--show-error-end", "--no-incremental"],
			"problemMatcher": {
				"owner": "mypy",
				"fileLocation": ["relative", "${workspaceFolder}"],
				"pattern": {
					"regexp": "^(.*?):(\\d+):(\\d+):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"endLine": 4,
					"endColumn": 5,
					"severity": 6,
					"message": 7
				}
			},
			"group": "build"
		}
	]
}
